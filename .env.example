# LexisLocal — vzor konfigurace prostředí.
# Zkopírujte na `.env` a vyplňte SILNÉ, náhodné hodnoty. Soubor .env je v .gitignore
# a NESMÍ se commitovat. Silný náhodný řetězec vygenerujete např.:
#   openssl rand -base64 32

# Heslo k databázi Paperless (Postgres). Používá se na dvou místech v docker-compose,
# musí být stejné.
PAPERLESS_DB_PASSWORD=zmente-me-na-silne-nahodne-heslo

# Tajný klíč Paperless (Django SECRET_KEY). Náhodný, dlouhý.
PAPERLESS_SECRET_KEY=zmente-me-na-nahodny-dlouhy-klic

# (Volitelné) Token pro LexisLocal API — když je nastaven, vynutí se autentizace
# u backendu na :4000. Stejný token vložte do nastavení editoru i dashboardu.
# API_TOKEN=zmente-me-na-nahodny-token

# ─────────────────────────────────────────────────────────────────────────────
# Backend LexisLocal — běh a bezpečnost
# ─────────────────────────────────────────────────────────────────────────────

# Port API backendu.
# PORT=4000

# Složka sledovaných dokumentů (spisy). Výchozí dle instalace.
# WATCH_DIR=/cesta/ke/spisum

# Vazba na síťové rozhraní. VÝCHOZÍ 127.0.0.1 = jen tento počítač (bezpečné, solo režim).
# Pro firemní/LAN nasazení nastavte 0.0.0.0 (nebo konkrétní IP) — PAK ale MUSÍTE
# zapnout LEXIS_ENFORCE_TOKEN=1 a USE_HTTPS=true (jinak backend hlásí varování).
# BIND_HOST=127.0.0.1

# Vynucení API tokenu. Prázdné/0 = opt-in (chrání loopback). 1 = vynuceno pro všechny
# /api/* požadavky. Povinné, jakmile je BIND_HOST mimo loopback.
# LEXIS_ENFORCE_TOKEN=0

# Umístění šifrovacího klíče a tokenu (mimo datovou složku). Výchozí ~/.lexislocal.
# Ve firemním režimu drží klíč server (server-controlled dir).
# LEXIS_KEY_DIR=/var/lib/lexislocal

# Datové úložiště. json = výchozí (solo). sqlite|postgres = firemní režim (souběh).
# LEXIS_STORE=json

# HTTPS/TLS. Pro síťové (firemní) nasazení zapněte a doplňte certifikáty.
# USE_HTTPS=false
# SSL_KEY_PATH=key.pem
# SSL_CERT_PATH=cert.pem

# Model pro RAG embeddingy (Ollama).
# EMBEDDING_MODEL=nomic-embed-text

# Napojení na Paperless-ngx (volitelné).
# PAPERLESS_API_URL=http://localhost:8000
# PAPERLESS_API_TOKEN=

# SMTP pro odesílání e-mailů řeší nastavení v aplikaci; TLS se vynucuje (STARTTLS),
# opt-out jen vědomě přes smtp_allow_insecure v konfiguraci SMTP.
